# Canonical site URL used for metadata, sitemap and structured data.
# Keep this aligned with the single production hostname.
NEXT_PUBLIC_SITE_URL=https://www.plebs.co.za

# Force noindex on any environment (useful for protected staging).
# PLEBS_NOINDEX=true

# Preview deployments are noindexed automatically via VERCEL_ENV=preview.

# Pooled PostgreSQL URL used by the Next.js application at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/plebs?sslmode=require

# Direct PostgreSQL URL used only by Prisma migrations and schema tooling.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/plebs?sslmode=require

# Auth.js secret. Mandatory. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Note: `npx auth secret` currently targets Better Auth and emits BETTER_AUTH_SECRET.
AUTH_SECRET=replace-with-a-long-random-value

# Trust the host header behind Vercel/proxies (same as trustHost: true).
AUTH_TRUST_HOST=true

# Optional Auth.js URL override for local development.
# AUTH_URL=http://localhost:3001

# Owner account created/updated by `npm run db:seed`.
# Do not commit real credentials.
ADMIN_EMAIL=owner@plebs.co.za
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=PLEBS Owner

# Paystack payment gateway (ZAR).
# Leave blank to keep orders in "awaiting payment" state.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend transactional email.
# Verify plebs.co.za in Resend before using an @plebs.co.za sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL="PLEBS <orders@plebs.co.za>"

# Receives contact-form messages and new paid-order notifications.
CONTACT_TO_EMAIL=hello@plebs.co.za

# Google Maps JavaScript API key (Places Autocomplete on checkout).
# Enable "Maps JavaScript API" + "Places API" in Google Cloud Console.
# Restrict the key by HTTP referrer (localhost + your production domain).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX).
# Loads automatically for storefront visitors (no cookie banner gate).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Auto-complete delivered orders after a quiet period (PLEBS-ORDERS-007).
# Owner decision: set in line with the published returns policy.
# Must be at least as long as the statutory ECTA cooling-off period
# measured from delivery (currently seven days). Leave unset to disable.
# ORDER_AUTO_COMPLETE_QUIET_PERIOD_DAYS=

# Shared secret for POST /api/cron/auto-complete-orders.
# Required when calling the route; leave unset to keep the route disabled.
# ORDER_AUTO_COMPLETE_CRON_SECRET=

# Vercel Cron authentication. Native Vercel cron invokes GET
# /api/cron/integration-outbox/ with Authorization: Bearer <CRON_SECRET>.
# Generate a random string of at least 16 characters.
# CRON_SECRET=

# Shared secret for POST /api/cron/integration-outbox (Resend + email retries).
# Still accepted for manual POST. Vercel cron uses CRON_SECRET above.
# INTEGRATION_OUTBOX_CRON_SECRET=

# Resend Contacts / Topics (Neon remains the source of truth).
# Topic should default to opt_out. Segment is the sendable newsletter list.
# RESEND_NEWSLETTER_TOPIC_ID=
# RESEND_NEWSLETTER_SEGMENT_ID=
# RESEND_WEBHOOK_SECRET=
