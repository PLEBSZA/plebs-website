# Canonical site URL used for metadata, sitemap and structured data.
# Keep this aligned with the single production hostname.
NEXT_PUBLIC_SITE_URL=https://www.plebs.co.za

# Force noindex on any environment (useful for protected staging).
# PLEBS_NOINDEX=true

# Preview deployments are noindexed automatically via VERCEL_ENV=preview.

# Pooled PostgreSQL URL used by the Next.js application at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/plebs?sslmode=require

# Direct PostgreSQL URL used only by Prisma migrations and schema tooling.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/plebs?sslmode=require

# Auth.js secret. Mandatory. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Note: `npx auth secret` currently targets Better Auth and emits BETTER_AUTH_SECRET.
AUTH_SECRET=replace-with-a-long-random-value

# Trust the host header behind Vercel/proxies (same as trustHost: true).
AUTH_TRUST_HOST=true

# Optional Auth.js URL override for local development.
# AUTH_URL=http://localhost:3001

# Owner account created/updated by `npm run db:seed`.
# Do not commit real credentials.
ADMIN_EMAIL=owner@plebs.co.za
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=PLEBS Owner

# Paystack payment gateway (ZAR).
# Leave blank to keep orders in "awaiting payment" state.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
